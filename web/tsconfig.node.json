{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "playwright.config.ts", "playwright.fullstack.config.ts", "e2e/**/*.ts", "fullstack/**/*.ts", "src/test-fixtures.ts", "src/types.ts"]
}
